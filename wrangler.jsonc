{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bladeball-value-list",
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-07-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/app.js",
      "/app.min.js",
      "/team.min.js",
      "/bot-support.js",
      "/consent.min.js",
      "/login-consent.js",
      "/styles.css",
      "/bot-support.css",
      "/consent.css",
      "/login-consent.css",
      "/favicon.ico",
      "/team",
      "/team/",
      "/team.html",
      "/bot",
      "/bot/",
      "/bot.html",
      "/privacy",
      "/privacy/",
      "/privacy.html",
      "/terms",
      "/terms/",
      "/terms.html",
      "/robots.txt",
      "/bots.txt",
      "/.well-known/security.txt",
      "/llms.txt",
      "/llm.txt",
      "/llms-full.txt",
      "/sitemap.xml",
      "/api/*",
      "/images/*",
      "/media/*",
      "/.env*",
      "/.git",
      "/.git/*",
      "/wp-login*",
      "/wp-admin*",
      "/xmlrpc.php",
      "/phpmyadmin*",
      "/admin",
      "/admin/*"
    ]
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] },
  "routes": [{ "pattern": "bbtsl.lol/*", "zone_name": "bbtsl.lol" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bladeball-value-list",
    "database_id": "8526c5b5-390b-47e0-b462-7059e1c52209"
  }],
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "bbtsl-media" },
    { "binding": "MEDIA_QUARANTINE_BUCKET", "bucket_name": "bbtsl-media-quarantine" }
  ],
  "vars": {
    "SITE_NAME": "BBTSL Blade Ball Top Spender List",
    "PUBLIC_SITE_URL": "https://bbtsl.lol",
    "DISCORD_REDIRECT_URI": "https://bbtsl.lol/api/auth/callback",
    "BBTSL_BOT_CLIENT_ID": "bbtsl-discord-bot",
    "BOT_REAUTH_REDIRECT_URI": "https://bbtsl.lol/api/bot/v1/reauth/callback"
  }
}
